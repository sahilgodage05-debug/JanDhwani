# ==========================================
# Google Cloud & Firebase Configuration
# ==========================================

# Mock mode allows you to run the backend and test it without GCP credentials.
# Set this to "false" when you are ready to connect to real Google APIs.
MOCK_MODE=true

# Google Cloud Project ID (Required for Vertex AI, BigQuery, and Speech-to-Text)
GCP_PROJECT_ID=your-google-cloud-project-id

# Location for Vertex AI (e.g., us-central1, asia-south1)
GCP_LOCATION=us-central1

# BigQuery Dataset and Table configuration
BQ_DATASET_ID=jandhwani_data
BQ_TABLE_ID=district_demographics

# Firebase Configuration
# Absolute path to your downloaded Firebase Admin SDK serviceAccountKey.json file
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-adminsdk-key.json

# Your Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
